#!/bin/sh
set -eu
lb config noauto --mode debian --distribution trixie --architecture amd64 \
 --binary-image iso-hybrid --bootloaders "syslinux grub-efi" \
 --archive-areas "main contrib non-free non-free-firmware" \
 --debian-installer live --debian-installer-gui true \
 --firmware-chroot true --firmware-binary true \
 --iso-application "Laccaz OS 0.3 Developer Preview" \
 --iso-volume LACCAZ_OS_03 --iso-publisher "Laccaz Project" \
 --bootappend-live "boot=live components username=developer hostname=laccaz locales=ru_RU.UTF-8 keyboard-layouts=us,ru" \
 --checksums sha256 --apt-recommends true "$@"
